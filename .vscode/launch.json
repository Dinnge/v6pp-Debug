{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "V6++ Lifecycle Attach",
      "type": "cppdbg",
      "request": "launch",
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "miDebuggerServerAddress": "127.0.0.1:1234",
      "program": "${workspaceFolder}/target/objs/boot/boot_debug.elf",
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "V6++: Check Lifecycle Target",
      "externalConsole": false,
      "stopAtEntry": false,
      "setupCommands": [
        {
          "description": "i386 symbols",
          "text": "set architecture i386"
        },
        {
          "description": "allow source breakpoints before symbol handoff",
          "text": "set breakpoint pending on"
        },
        {
          "description": "intel disassembly",
          "text": "set disassembly-flavor intel",
          "ignoreFailures": true
        },
        {
          "description": "load kernel symbols after the bootloader image",
          "text": "add-symbol-file ${workspaceFolder}/target/objs/kernel.exe"
        }
      ]
    },
    {
      "name": "V6PP Legacy qemu-gdb.sock Attach",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/target/objs/apps-elf/procTest",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}/src",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerServerAddress": "${workspaceFolder}/target/qemu-gdb.sock",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        },
        {
          "description": "Set Disassembly Flavor to Intel",
          "text": "-gdb-set disassembly-flavor intel",
          "ignoreFailures": true
        }
      ],
      "miDebuggerPath": "/usr/bin/gdb"
    }
  ]
}
