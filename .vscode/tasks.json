{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "V6++: Install VSCode Frontend",
      "type": "shell",
      "command": "bash",
      "args": [
        "tools/vscode/install_local_extension.sh"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "V6++: Deploy Full Debug",
      "type": "shell",
      "command": "make",
      "args": [
        "deploy-full-debug"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "V6++: Boot Lifecycle QEMU (no rebuild)",
      "type": "shell",
      "command": "make",
      "args": [
        "qemug-boot-no-rebuild"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "V6++: Check Lifecycle Target",
      "type": "shell",
      "command": "bash",
      "args": [
        "-lc",
        "if [[ ! -f target/objs/boot/boot_debug.elf ]]; then echo 'Missing target/objs/boot/boot_debug.elf. Run: make deploy-full-debug'; exit 1; fi\nif [[ ! -f target/objs/kernel.exe ]]; then echo 'Missing target/objs/kernel.exe. Run: make deploy-full-debug'; exit 1; fi\nif ! ss -ltn | awk '{print $4}' | grep -Eq '(^|:)1234$'; then echo 'Lifecycle stub is not listening on 127.0.0.1:1234. Run: make qemug-boot-no-rebuild'; exit 1; fi\necho 'V6++ lifecycle target is ready on 127.0.0.1:1234'"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      }
    }
  ]
}
