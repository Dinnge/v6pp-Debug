{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "V6++ Lifecycle Attach",
      "type": "cppdbg",
      "request": "launch",
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "miDebuggerServerAddress": "127.0.0.1:1234",
      "program": "${workspaceFolder}/target/objs/boot/boot_debug.elf",
      "cwd": "${workspaceFolder}",
      "externalConsole": false,
      "stopAtEntry": false,
      "setupCommands": [
        {
          "description": "i386 symbols",
          "text": "set architecture i386"
        },
        {
          "description": "allow source breakpoints before symbol handoff",
          "text": "set breakpoint pending on"
        },
        {
          "description": "load kernel symbols after the bootloader image",
          "text": "add-symbol-file ${workspaceFolder}/target/objs/kernel.exe"
        }
      ]
    }
  ]
}
